# Local defaults work without an .env file.
PORT=3000
DATA_DIR=.data
# On an HTTPS staging host set the EXACT origin (no trailing slash).
# PUBLIC_ORIGIN=https://your-service.onrender.com
# SESSION_SECRET=generate-a-long-random-secret-for-hosting
# STAGING_ACCESS_CODE=share-only-with-adult-testers
MAX_CONNECTIONS=100
# Optional TURN provider credentials; never prefix with NEXT_PUBLIC_.
# TURN_URLS=turn:your-relay.example:3478,turns:your-relay.example:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=


# Set relay temporarily to verify TURN; default all allows direct connections.
# ICE_TRANSPORT_POLICY=all
